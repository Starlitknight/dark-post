{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dark-post",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/i/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }]
}
